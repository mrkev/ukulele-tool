{
  "compilerOptions": {
    "composite": true,
    // `tsc -b` requires referenced projects to emit (noEmit here is TS6310), but
    // we only want the typecheck. Park the output under node_modules so it stays
    // out of the tree -- a stray vite.config.js next to vite.config.ts would
    // otherwise shadow the real config.
    "outDir": "./node_modules/.tmp/tsc-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,

    // components. No baseUrl: paths resolve relative to this file, which keeps
    // the alias working and is forward-compatible (TS 7 removes baseUrl).
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts"]
}
